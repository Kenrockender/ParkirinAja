generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USER & AUTH ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  photoUrl      String?
  role          String   @default("USER") // USER | ADMIN
  isBinusian    Boolean  @default(false) // detected from @binus.ac.id domain
  nim           String? // future NIM verification
  walletBalance Int      @default(0) // IDR
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles          Vehicle[]
  reservations      Reservation[]
  walletTransactions WalletTransaction[]
}

model Vehicle {
  id          String   @id @default(cuid())
  userId      String
  nickname    String
  brand       String?
  model       String?
  color       String?
  licensePlate String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

// ============ PARKING ============

model ParkingLocation {
  id                  String  @id @default(cuid())
  name                String
  campus              String
  address             String
  operatingHours      String  @default("06:00 - 22:00")
  openHour            Int     @default(6)
  closeHour           Int     @default(22)
  // platform service fees (IDR)
  advanceFee          Int     @default(20000)
  walkInFee           Int     @default(30000)
  overtimeFeePerHour Int     @default(5000)
  // BINUS parking tariff (configurable per location) — student car
  parkFirstHours      Int     @default(3)
  parkFirstHoursFee   Int     @default(4000)
  parkAddHourFee      Int     @default(3000)
  parkMaxFee          Int     @default(13000)
  // refund policy
  refundFullBeforeH   Int     @default(24) // >24h before start => 100%
  refundPartialPct    Int     @default(50) // <=24h => 50%
  // no-show refund pct
  noShowRefundPct     Int     @default(0)
  active              Boolean @default(true)
  createdAt           DateTime @default(now())

  slots        ParkingSlot[]
  reservations Reservation[]
}

model ParkingSlot {
  id         String  @id @default(cuid())
  locationId String
  slotNumber String // "A-01"
  rowLabel   String // "A"
  rowIndex   Int // sort order of row
  colIndex   Int // position in row
  status     String  @default("AVAILABLE") // AVAILABLE | MAINTENANCE
  active     Boolean @default(true)

  location     ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

// ============ RESERVATION ============

model Reservation {
  id     String @id @default(cuid())
  code   String @unique // RES-20260912-0001
  userId String
  locationId String
  slotId String
  vehicleId String?

  type      String // ADVANCE | WALK_IN
  date      String // YYYY-MM-DD (WIB)
  startTime String // HH:mm
  endTime   String // HH:mm

  // driver snapshot (driver may differ from account owner)
  driverName   String
  driverPhone  String?
  vehiclePlate String
  vehicleLabel String?

  // fees (IDR)
  serviceFee   Int @default(0)
  parkingFee   Int @default(0)
  overtimeFee  Int @default(0)
  refundAmount Int @default(0)
  totalAmount  Int @default(0)

  // lifecycle: PENDING_PAYMENT | CONFIRMED | CHECKED_IN | COMPLETED | CANCELLED | EXPIRED | NO_SHOW
  status         String @default("CONFIRMED")
  actualEntryTime DateTime?
  actualExitTime  DateTime?

  // QR access
  qrCode  String  @unique
  qrUsed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  slot         ParkingSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
}

// ============ WALLET ============

model WalletTransaction {
  id             String   @id @default(cuid())
  userId         String
  type           String // TOPUP | PAYMENT | REFUND | OVERTIME
  amount         Int // signed: + credit, - debit
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String? // RESERVATION | AD | MANUAL
  referenceId    String?
  description    String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ ADVERTISING ============

model Advertisement {
  id             String   @id @default(cuid())
  title          String
  description    String?
  imageTheme     String   @default("coffee") // banner theme key or 'image' for custom URL
  imageUrl       String? // custom image URL when imageTheme = 'image'
  ctaText        String   @default("Kunjungi")
  destinationUrl String?
  startAt        DateTime
  endAt          DateTime
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE
  clicks         Int      @default(0)
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
